{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reading-support.schema.json",
  "title": "ReadingSupport",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "support_version": {
      "const": "reading-support/1"
    },
    "report_id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "report_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "report_digest": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence_digest": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "image_sha256": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "descriptors": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/ReadingSupportDescriptorsItem"
      },
      "minItems": 0,
      "maxItems": 12
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/ReadingSupportRelationsItem"
      },
      "minItems": 0,
      "maxItems": 8
    },
    "regions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/ReadingSupportRegionsItem"
      },
      "minItems": 0,
      "maxItems": 32
    },
    "support_digest": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "contract_version",
    "support_version",
    "report_id",
    "report_revision",
    "report_digest",
    "evidence_digest",
    "image_sha256",
    "descriptors",
    "relations",
    "regions",
    "support_digest"
  ]
}
