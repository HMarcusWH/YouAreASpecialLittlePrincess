{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "premium-reading-output.schema.json",
  "title": "PremiumReadingOutput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "packet_id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "output_schema_version": {
      "const": "premium-reading-output/2"
    },
    "selector_output": {
      "$ref": "premium-output.schema.json"
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/PremiumReadingOutputBlocksItem"
      },
      "minItems": 3,
      "maxItems": 8
    }
  },
  "required": [
    "contract_version",
    "packet_id",
    "output_schema_version",
    "selector_output",
    "blocks"
  ]
}
