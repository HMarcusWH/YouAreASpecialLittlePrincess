          "contract_version": {
            "const": "1.0.0"
          },
          "created_at": {
            "$ref": "#/components/schemas/Rfc3339Utc"
          },
          "input_asset_id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "input_sha256": {
            "$ref": "#/components/schemas/Sha256"
          },
          "owner_id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "processed_sha256": {
            "$ref": "#/components/schemas/Sha256"
