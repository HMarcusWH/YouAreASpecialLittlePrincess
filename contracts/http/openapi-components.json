      "AvailabilityState": {
        "enum": [
          "READY",
          "MISSING",
          "NOT_IMPLEMENTED",
          "INELIGIBLE",
          "UNCALIBRATED",
          "LOCKED",
          "PENDING",
          "FAILED",
          "REVOKED"
