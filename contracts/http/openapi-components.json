              "COMPARE",
              "EXPORT",
              "SHARE",
              "SAVE",
              "DELETE",
              "PURCHASE"
            ],
            "maxLength": 32,
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "maxLength": 256,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "action_id",
          "kind",
          "enabled",
          "reason"
        ],
        "type": "object"
      },
      "AnalysisReference": {
        "additionalProperties": false,
        "properties": {
          "analysis_id": {
            "$ref": "#/components/schemas/OpaqueId"
