{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:princess:contracts:consent:v1:collection-protocol",
  "title": "CollectionProtocol",
  "$comment": "Describes content/collection/v1/manifest.json: versioned tasks, prompts, guidance and cohort separation rules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "protocol_id", "version", "status", "gate", "consent_purposes", "supported_contexts",
    "pooling", "tasks", "guidance", "session_plan", "exclusions"
  ],
  "properties": {
    "contract_version": {"const": "collection-protocol/v1"},
    "protocol_id": {"$ref": "common.schema.json#/$defs/stable_key"},
    "version": {"$ref": "common.schema.json#/$defs/version"},
    "status": {"enum": ["DRAFT_PENDING_OWNER_REVIEW", "APPROVED"]},
    "gate": {"const": "pilot_rights_consent"},
    "consent_purposes": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/purpose_ref"}},
    "supported_contexts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scripts", "languages"],
      "properties": {
        "scripts": {"type": "array", "minItems": 1, "items": {"enum": ["LATIN"]}, "uniqueItems": true},
        "languages": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/locale"}, "uniqueItems": true}
      }
    },
    "pooling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["copy_with_free", "across_languages", "repeat_captures_as_writers"],
      "properties": {
        "copy_with_free": {"const": false},
        "across_languages": {"const": false},
        "repeat_captures_as_writers": {"const": false}
      }
    },
    "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}},
    "guidance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/guidance"}},
    "session_plan": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/session"}},
    "exclusions": {"$ref": "common.schema.json#/$defs/text_list"}
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "task_kind", "language", "prompt_file", "prompt_sha256", "rights"],
      "properties": {
        "task_id": {"$ref": "common.schema.json#/$defs/stable_key"},
        "task_kind": {"enum": ["COPY", "FREE"]},
        "language": {"$ref": "common.schema.json#/$defs/locale"},
        "prompt_file": {"type": "string", "pattern": "^prompts/[a-z0-9-]+\\.v[0-9]+\\.md$"},
        "prompt_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["origin", "decision_status", "decision_ref"],
          "properties": {
            "origin": {"const": "ORIGINAL_FOR_THIS_PROJECT"},
            "decision_status": {"$ref": "common.schema.json#/$defs/decision_status"},
            "decision_ref": {"$ref": "common.schema.json#/$defs/decision_ref"}
          }
        }
      }
    },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guidance_id", "locale", "file", "sha256"],
      "properties": {
        "guidance_id": {"$ref": "common.schema.json#/$defs/stable_key"},
        "locale": {"$ref": "common.schema.json#/$defs/locale"},
        "file": {"type": "string", "pattern": "^guidance/[a-z0-9-]+\\.[a-z]{2}\\.md$"},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_index", "participants", "tasks_per_language", "repeat_captures", "summary"],
      "properties": {
        "session_index": {"$ref": "common.schema.json#/$defs/version"},
        "participants": {"enum": ["ALL_ENROLLED", "OPTIONAL_SUBSET"]},
        "tasks_per_language": {"type": "array", "minItems": 1, "items": {"enum": ["COPY", "FREE"]}, "uniqueItems": true},
        "repeat_captures": {"enum": ["NONE", "SELECTED_PAGES"]},
        "summary": {"$ref": "common.schema.json#/$defs/text"}
      }
    }
  }
}
