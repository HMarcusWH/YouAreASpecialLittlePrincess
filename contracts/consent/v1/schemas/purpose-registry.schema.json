{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:princess:contracts:consent:v1:purpose-registry",
  "title": "PurposeRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "registry_status", "legal_basis_status", "purposes"],
  "properties": {
    "contract_version": {"const": "purpose-registry/v1"},
    "registry_status": {"enum": ["DRAFT_PENDING_OWNER_REVIEW", "APPROVED"]},
    "approval": {"$ref": "#/$defs/approval"},
    "legal_basis_status": {"$ref": "common.schema.json#/$defs/decision_status"},
    "purposes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/purpose"}
    }
  },
  "$defs": {
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_ref", "decided_by_role", "decided_on"],
      "properties": {
        "decision_ref": {"$ref": "common.schema.json#/$defs/decision_ref"},
        "decided_by_role": {"$ref": "common.schema.json#/$defs/text"},
        "decided_on": {"$ref": "common.schema.json#/$defs/timestamp"}
      }
    },
    "purpose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose_id", "purpose_version", "status", "summary", "subject_kind", "required_for_service",
        "affects_free_report", "presented_default", "grant_scopes", "requires_author_authority",
        "requires_adult_declaration", "data_categories", "recipients", "retention_classes",
        "withdrawal", "related_gates", "legal_basis", "not_implied_by"
      ],
      "properties": {
        "purpose_id": {"$ref": "common.schema.json#/$defs/stable_key"},
        "purpose_version": {"$ref": "common.schema.json#/$defs/version"},
        "status": {"enum": ["DRAFT", "NOT_OFFERED", "APPROVED", "RETIRED"]},
        "approval": {"$ref": "#/$defs/approval"},
        "summary": {"$ref": "common.schema.json#/$defs/text"},
        "subject_kind": {"enum": ["WRITER", "ACCOUNT"]},
        "required_for_service": {"type": "boolean"},
        "affects_free_report": {"type": "boolean"},
        "presented_default": {"enum": ["UNSELECTED", "SELECTED"]},
        "grant_scopes": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/scope_kind"},
          "uniqueItems": true
        },
        "requires_author_authority": {"type": "boolean"},
        "requires_adult_declaration": {"type": "boolean"},
        "data_categories": {"$ref": "common.schema.json#/$defs/text_list"},
        "recipients": {"$ref": "common.schema.json#/$defs/text_list"},
        "retention_classes": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/stable_key"},
          "uniqueItems": true
        },
        "withdrawal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "effect", "propagation"],
          "properties": {
            "available": {"type": "boolean"},
            "effect": {"enum": ["PROSPECTIVE"]},
            "propagation": {"$ref": "common.schema.json#/$defs/text_list"}
          }
        },
        "related_gates": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/stable_key"},
          "uniqueItems": true
        },
        "legal_basis": {"$ref": "common.schema.json#/$defs/decision_status"},
        "not_implied_by": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/text"},
          "uniqueItems": true,
          "description": "Business events that must never be read as this permission, e.g. a purchase."
        }
      }
    }
  }
}
