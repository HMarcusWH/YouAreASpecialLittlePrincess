{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:princess:contracts:consent:v1:notice-registry",
  "title": "NoticeRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "notices"],
  "properties": {
    "contract_version": {"const": "notice-registry/v1"},
    "notices": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/notice"}}
  },
  "$defs": {
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notice_id", "version", "status", "purposes", "effective_from", "effective_until", "decision_ref", "content_sha256", "end_decision_ref", "end_decided_by_role", "end_decided_on", "end_content_sha256", "copy"],
      "properties": {
        "notice_id": {"$ref": "common.schema.json#/$defs/dotted_key"},
        "version": {"$ref": "common.schema.json#/$defs/version"},
        "status": {"enum": ["DRAFT", "ACTIVE", "SUPERSEDED"]},
        "purposes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "common.schema.json#/$defs/purpose_ref"}
        },
        "effective_from": {"$ref": "common.schema.json#/$defs/nullable_timestamp"},
        "effective_until": {"$ref": "common.schema.json#/$defs/nullable_timestamp"},
        "decision_ref": {"$ref": "common.schema.json#/$defs/decision_ref"},
        "content_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$",
          "description": "What the activation decision approved: SHA-256 of the canonical JSON of the notice without status, final end-decision fields or content_sha256, so decision_ref is bound too. Null exactly while DRAFT; changed purposes or wording need a new notice version."
        },
        "end_decision_ref": {"$ref": "common.schema.json#/$defs/decision_ref"},
        "end_decided_by_role": {"type": ["string", "null"], "minLength": 1},
        "end_decided_on": {"$ref": "common.schema.json#/$defs/nullable_timestamp"},
        "end_content_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$",
          "description": "For SUPERSEDED only: binds notice identity, activation content hash, effective_until and the recorded end decision so the historical notice window cannot be extended under the old decision."
        },
        "copy": {
          "type": "array",
          "items": {"$ref": "#/$defs/choice_copy"}
        }
      }
    },
    "choice_copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose_id", "locale", "label", "explanation", "decline_consequence"],
      "properties": {
        "purpose_id": {"$ref": "common.schema.json#/$defs/stable_key"},
        "locale": {"$ref": "common.schema.json#/$defs/locale"},
        "label": {"$ref": "common.schema.json#/$defs/text"},
        "explanation": {"$ref": "common.schema.json#/$defs/text"},
        "decline_consequence": {"$ref": "common.schema.json#/$defs/text"}
      }
    }
  }
}
