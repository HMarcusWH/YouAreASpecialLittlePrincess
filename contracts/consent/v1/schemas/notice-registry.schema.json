{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:princess:contracts:consent:v1:notice-registry",
  "title": "NoticeRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "notices"],
  "properties": {
    "contract_version": {"const": "notice-registry/v1"},
    "notices": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/notice"}}
  },
  "$defs": {
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notice_id", "version", "status", "purposes", "effective_from", "effective_until", "decision_ref", "copy"],
      "properties": {
        "notice_id": {"$ref": "common.schema.json#/$defs/dotted_key"},
        "version": {"$ref": "common.schema.json#/$defs/version"},
        "status": {"enum": ["DRAFT", "ACTIVE", "SUPERSEDED"]},
        "purposes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "common.schema.json#/$defs/purpose_ref"}
        },
        "effective_from": {"$ref": "common.schema.json#/$defs/nullable_timestamp"},
        "effective_until": {"$ref": "common.schema.json#/$defs/nullable_timestamp"},
        "decision_ref": {"$ref": "common.schema.json#/$defs/decision_ref"},
        "copy": {
          "type": "array",
          "items": {"$ref": "#/$defs/choice_copy"}
        }
      }
    },
    "choice_copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose_id", "locale", "label", "explanation", "decline_consequence"],
      "properties": {
        "purpose_id": {"$ref": "common.schema.json#/$defs/stable_key"},
        "locale": {"$ref": "common.schema.json#/$defs/locale"},
        "label": {"$ref": "common.schema.json#/$defs/text"},
        "explanation": {"$ref": "common.schema.json#/$defs/text"},
        "decline_consequence": {"$ref": "common.schema.json#/$defs/text"}
      }
    }
  }
}
