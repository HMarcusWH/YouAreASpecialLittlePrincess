{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:princess:release:runtime-release:1",
  "title": "RuntimeRelease",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source_sha",
    "database",
    "product_contract",
    "engine",
    "measurement",
    "interpretation",
    "reports",
    "api",
    "runtime"
  ],
  "properties": {
    "version": {
      "const": "runtime-release/1"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head_revision"
      ],
      "properties": {
        "head_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "product_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "bundle_sha256"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "bundle_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_schema_version",
        "feature_source_sha256",
        "method_manifest_sha256"
      ],
      "properties": {
        "feature_schema_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "feature_source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "method_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sha256"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "reports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "write_template",
        "read_templates",
        "presentation",
        "highlight_policy",
        "render_template"
      ],
      "properties": {
        "write_template": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "read_templates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "presentation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "highlight_policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "render_template": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_v1_routes"
      ],
      "properties": {
        "public_v1_routes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(GET|POST|PUT|PATCH|DELETE|OPTIONS|HEAD) /v1/"
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "python_lock_sha256",
        "dockerfile_sha256"
      ],
      "properties": {
        "platform": {
          "const": "linux/amd64"
        },
        "python_lock_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dockerfile_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
