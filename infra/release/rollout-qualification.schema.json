{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:princess:release:rollout-qualification:1",
  "title": "RolloutQualification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "event_kind",
    "candidate_sha",
    "candidate_head_sha",
    "rollback_base_sha",
    "candidate_manifest_sha256",
    "rollback_base_manifest_sha256",
    "database_revision",
    "checks",
    "candidate_on_candidate_db",
    "rollback_base_on_candidate_db",
    "base_write_candidate_read",
    "candidate_write_base_read",
    "historical_expand_witness",
    "database_downgrade_performed",
    "queue_state_requirement",
    "scope",
    "result"
  ],
  "properties": {
    "version": {
      "const": "rollout-qualification/1"
    },
    "event_kind": {
      "enum": [
        "PREMERGE",
        "PUSH"
      ]
    },
    "candidate_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidate_head_sha": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "rollback_base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidate_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rollback_base_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "database_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_contract_major_compatible",
        "route_surface_backward_compatible",
        "report_read_forward_compatible",
        "report_write_rollback_compatible",
        "runtime_platform_compatible"
      ],
      "properties": {
        "product_contract_major_compatible": {
          "type": "boolean"
        },
        "route_surface_backward_compatible": {
          "type": "boolean"
        },
        "report_read_forward_compatible": {
          "type": "boolean"
        },
        "report_write_rollback_compatible": {
          "type": "boolean"
        },
        "runtime_platform_compatible": {
          "type": "boolean"
        }
      }
    },
    "candidate_on_candidate_db": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN"
      ]
    },
    "rollback_base_on_candidate_db": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN"
      ]
    },
    "base_write_candidate_read": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN"
      ]
    },
    "candidate_write_base_read": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN"
      ]
    },
    "historical_expand_witness": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN"
      ]
    },
    "database_downgrade_performed": {
      "const": false
    },
    "queue_state_requirement": {
      "const": "DRAINED_OR_FENCED"
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "API",
          "FREE_ANALYSIS_WORKER",
          "REPORT_PERSISTENCE_READ"
        ]
      }
    },
    "result": {
      "enum": [
        "STATIC_PASS",
        "PASS",
        "FAIL"
      ]
    }
  }
}
