{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alert-policy.schema.json",
  "title": "OperationalAlertPolicyV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "environment", "rules"],
  "properties": {
    "version": {"const": "operational-alert-policy/1"},
    "environment": {"enum": ["local", "test", "preview", "staging", "production"]},
    "rules": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alert_code", "source", "category", "state", "measure", "operator", "threshold"],
        "properties": {
          "alert_code": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
          "source": {"type": "string"},
          "category": {"type": "string"},
          "state": {"type": "string"},
          "measure": {"enum": ["count", "oldest_age_s", "max_attempts"]},
          "operator": {"enum": ["gt", "gte"]},
          "threshold": {"type": "integer", "minimum": 0, "maximum": 2147483647}
        }
      }
    }
  }
}
