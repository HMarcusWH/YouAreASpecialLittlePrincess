      "state-danger": "#FF9A90",
      "state-info": "#86B6FF",
      "state-locked": "#B8B0C0"
    }
  },
  "contrast": {
    "text": {"minimum": 4.5, "roles": ["text", "text-muted", "evidence-measured", "evidence-proxy", "evidence-reference", "evidence-authored", "evidence-traditional", "evidence-ai", "state-ready", "state-attention", "state-danger", "state-info", "state-locked", "accent"], "on": ["surface", "surface-sunken", "surface-raised"]},
    "ui": {"minimum": 3.0, "roles": ["border-strong", "focus"], "on": ["surface", "surface-sunken", "surface-raised"]},
    "pairs": [{"fg": "accent-contrast", "bg": "accent", "minimum": 4.5}]
  },
  "chart": {
    "series": ["#0072B2", "#E69F00", "#009E73", "#CC79A7", "#56B4E9", "#D55E00"],
    "note": "Okabe-Ito order. Series are also distinguished by marker shape and direct labels; missing values use a hatched 'no data' mark, never zero."
  },
  "font": {
    "family-text": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Noto Sans\", sans-serif",
    "family-numeric": "ui-monospace, \"SF Mono\", \"Roboto Mono\", Menlo, monospace",
    "size": {"xs": "0.75rem", "sm": "0.875rem", "md": "1rem", "lg": "1.125rem", "xl": "1.375rem", "2xl": "1.75rem", "3xl": "2.25rem"},
    "line-height": {"tight": "1.2", "normal": "1.5", "relaxed": "1.65"},
    "weight": {"regular": "400", "medium": "500", "bold": "700"}
  },
  "space": {"0": "0", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px"},
  "radius": {"sm": "4px", "md": "8px", "lg": "16px", "pill": "999px"},
  "motion": {
    "duration": {"fast": "120ms", "base": "200ms", "slow": "320ms"},
    "easing": {"standard": "cubic-bezier(0.2, 0, 0, 1)", "exit": "cubic-bezier(0.3, 0, 1, 1)"},
    "reduced": "All durations become 0ms under prefers-reduced-motion; reveals are instant, never skipped."
  },
  "breakpoint": {"sm": "480px", "md": "768px", "lg": "1024px", "xl": "1280px"},
  "target": {"min-touch": "44px"},
  "print": {"page-sizes": ["A4", "Letter"], "margin": "18mm", "base-size": "10.5pt"}
}
