      "evidence-authored": "#56515C",
      "evidence-traditional": "#8A4308",
      "evidence-ai": "#74339A",
      "state-ready": "#1E6E3E",
      "state-attention": "#7A5200",
      "state-danger": "#B3261E",
      "state-info": "#0B5CC2",
