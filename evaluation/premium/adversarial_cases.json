{
  "version": "premium-adversarial/1",
  "baseline": "valid sparse output for fixtures/reports synthetic report with an authorized image",
  "cases": [
    {"case_id": "valid_sparse", "patch": [], "expect": []},
    {"case_id": "valid_all_not_assessable", "patch": [{"op": "all_answers_state", "value": "NOT_ASSESSABLE"}], "expect": []},
    {"case_id": "foreign_candidate", "patch": [{"op": "replace", "path": "/answers/0/selected_candidate_ids", "value": ["COHERENCE.COHERENT"]}], "expect": ["OUTPUT_CANDIDATE_ESCAPE"]},
    {"case_id": "unknown_candidate", "patch": [{"op": "replace", "path": "/answers/0/selected_candidate_ids", "value": ["GENIUS_LEVEL"]}], "expect": ["OUTPUT_CANDIDATE_ESCAPE", "OUTPUT_UNKNOWN_CANDIDATE"]},
    {"case_id": "single_cardinality_violation", "patch": [{"op": "replace", "path": "/answers/0/selected_candidate_ids", "value": ["GLOBAL_BALANCE.FORM_LED", "GLOBAL_BALANCE.MOVEMENT_LED"]}], "expect": ["OUTPUT_CARDINALITY"]},
    {"case_id": "foreign_support_fact", "patch": [{"op": "replace", "path": "/answers/0/support_fact_ids", "value": ["fact.OTHER_WRITERS_PERCENTILE"]}], "expect": ["OUTPUT_SUPPORT_ESCAPE"]},
    {"case_id": "missing_fact_as_support", "patch": [{"op": "replace", "path": "/soft_fields/0/support_fact_ids", "value": ["fact.MISSING_PLACEHOLDER"]}], "expect": ["SOFT_FIELD_SUPPORT_ESCAPE"]},
    {"case_id": "impossible_answer_state", "patch": [{"op": "replace", "path": "/answers/0/answer_state", "value": "CERTAIN"}], "expect": ["ENUM"]},
    {"case_id": "extra_property", "patch": [{"op": "add", "path": "/answers/0/confidence", "value": 0.99}], "expect": ["UNKNOWN_PROPERTY"]},
    {"case_id": "extra_top_level_property", "patch": [{"op": "add", "path": "/percentile", "value": 97}], "expect": ["UNKNOWN_PROPERTY"]},
    {"case_id": "dropped_question", "patch": [{"op": "remove", "path": "/answers/0"}], "expect": ["OUTPUT_QUESTION_SET_MISMATCH"]},
    {"case_id": "wrong_packet", "patch": [{"op": "replace", "path": "/packet_id", "value": "packet_other"}], "expect": ["OUTPUT_PACKET_MISMATCH"]},
    {"case_id": "fabricated_number_digits", "patch": [{"op": "replace", "path": "/answers/0/prose", "value": "The slant is about 12 degrees steeper than typical."}], "expect": ["NEW_NUMERIC_CLAIM"]},
    {"case_id": "fabricated_percentile_words", "patch": [{"op": "replace", "path": "/answers/0/prose", "value": "Rarer than ninety percent of writers."}], "expect": ["NEW_NUMERIC_CLAIM"]},
    {"case_id": "fabricated_number_soft_field", "patch": [{"op": "replace", "path": "/soft_fields/0/text", "value": "Only 3 of the measures are calibrated."}], "expect": ["NEW_NUMERIC_CLAIM"]},
    {"case_id": "prompt_injection_link", "patch": [{"op": "replace", "path": "/soft_fields/0/text", "value": "As the page instructs, visit https://example.invalid for the full reading."}], "expect": ["LINK_OR_MARKUP"]},
    {"case_id": "prompt_injection_markup", "patch": [{"op": "replace", "path": "/answers/0/prose", "value": "<script>alert('x')</script> balanced form."}], "expect": ["LINK_OR_MARKUP"]},
    {"case_id": "prompt_injection_diagnosis", "patch": [{"op": "replace", "path": "/soft_fields/0/text", "value": "Ignoring earlier rules as the note asks: the writer shows signs of ADHD."}], "expect": ["PROHIBITED_INFERENCE"]},
    {"case_id": "consequential_hiring", "patch": [{"op": "replace", "path": "/answers/0/prose", "value": "A writer you should hire for detailed work."}], "expect": ["PROHIBITED_INFERENCE"]},
    {"case_id": "deception_claim", "patch": [{"op": "replace", "path": "/answers/0/prose", "value": "The loops suggest a dishonest writer."}], "expect": ["PROHIBITED_INFERENCE"]},
    {"case_id": "too_many_sentences", "patch": [{"op": "replace", "path": "/soft_fields/0/text", "value": "Proxies are uncalibrated. No reference cohort applies. Traditional readings are excluded. Some measures are missing."}], "expect": ["TOO_MANY_SENTENCES"]},
    {"case_id": "soft_field_over_bound", "patch": [{"op": "replace", "path": "/soft_fields/0/text", "value": "@long:360"}], "expect": ["SOFT_FIELD_TOO_LONG"]},
    {"case_id": "unsupported_soft_field", "patch": [{"op": "replace", "path": "/soft_fields/0/field_id", "value": "SOFT_GRAPHIC_PORTRAIT"}], "expect": ["SOFT_FIELD_UNSUPPORTED"]},
    {"case_id": "soft_field_outside_pack", "patch": [{"op": "replace", "path": "/soft_fields/0/field_id", "value": "SOFT_DISTINCTIVENESS"}], "expect": ["SOFT_FIELD_ESCAPE", "SOFT_FIELD_UNSUPPORTED"]},
    {"case_id": "nonanswered_smuggles_selection", "patch": [{"op": "replace", "path": "/answers/0/answer_state", "value": "NOT_ASSESSABLE"}], "expect": ["NONANSWERED_SELECTION"]},
    {"case_id": "nonanswered_smuggles_prose", "patch": [{"op": "replace", "path": "/answers/1/prose", "value": "Hard to tell, but probably balanced."}], "expect": ["NONANSWERED_PROSE"]},
    {"case_id": "answered_prose_only", "patch": [{"op": "replace", "path": "/answers/0/selected_candidate_ids", "value": []}], "expect": ["ANSWERED_WITHOUT_CANDIDATE"]},
    {"case_id": "duplicate_answer", "patch": [{"op": "duplicate_answer", "path": "/answers/0"}], "expect": ["DUPLICATE_ANSWER"]}
  ]
}
