{
  "name": "@princess/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "config:public": "expo config --type public",
    "prebuild:android": "expo prebuild --clean --no-install --platform android",
    "prebuild:ios": "expo prebuild --clean --no-install --platform ios"
  },
  "dependencies": {
    "@princess/api-client": "workspace:*",
    "@princess/contracts": "workspace:*",
    "@princess/design-tokens": "workspace:*",
    "@princess/report-core": "workspace:*",
    "expo": "~57.0.17",
    "expo-router": "~57.0.23",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "expo-dev-client": "~57.0.19",
    "expo-secure-store": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-image-manipulator": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-sharing": "~57.0.22",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.19",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "expo-iap": "5.6.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "@react-native/metro-config": "0.86.3"
  }
}
